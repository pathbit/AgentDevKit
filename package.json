{
  "name": "@pathbit/agentdevkit",
  "version": "0.0.25",
  "description": "Shared skills, specifications and workflows for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathbit/AgentDevKit.git"
  },
  "homepage": "https://github.com/pathbit/AgentDevKit#readme",
  "bugs": {
    "url": "https://github.com/pathbit/AgentDevKit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agentdevkit": "bin/agentdevkit.mjs"
  },
  "files": [
    "bin/",
    "src/",
    ".pbai4devs/",
    "docs/",
    "README.md",
    "README.en.md",
    "README.es.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node bin/agentdevkit.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs",
    "test:infra": "node .pbai4devs/scripts/testar-infraestrutura/SCRIPT.mjs",
    "examples": "node .pbai4devs/scripts/testar-maturidade/SCRIPT.mjs prepare",
    "test:examples": "node .pbai4devs/scripts/testar-maturidade/SCRIPT.mjs run",
    "generate": "npm run examples",
    "agents:sync": "node .pbai4devs/scripts/sincronizar-agentes/SCRIPT.mjs",
    "check": "node scripts/release/pipeline.mjs check",
    "verify": "node scripts/release/pipeline.mjs full",
    "build": "node scripts/release/assets.mjs",
    "pack:release": "node scripts/release/assets.mjs",
    "ci:full": "node scripts/release/pipeline.mjs full",
    "ci:portable": "node scripts/release/pipeline.mjs portable",
    "ci:smoke": "node scripts/release/pipeline.mjs smoke",
    "test:oss": "node tests/oss-compatibility.mjs",
    "test:docs": "node tests/documentation-compatibility.mjs"
  },
  "author": {
    "name": "PathBit",
    "url": "https://www.pathbit.com.br"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "agent-skills",
    "spec-driven-development",
    "developer-tools",
    "codex",
    "claude-code",
    "github-copilot"
  ]
}
