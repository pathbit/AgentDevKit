{
  "name": "@pathbit/agentdevkit",
  "version": "0.0.3",
  "description": "PathBit AgentDevKit: specs, skills and workflows for coding agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathbit/AgentDevKit.git"
  },
  "homepage": "https://github.com/pathbit/AgentDevKit#readme",
  "bugs": {
    "url": "https://github.com/pathbit/AgentDevKit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agentdevkit": ".pbai4devs/bin/agentdevkit.mjs"
  },
  "files": [
    ".pbai4devs/",
    "docs/",
    "README.md",
    "README.en.md",
    "README.es.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test .pbai4devs/tests/*.test.mjs",
    "test:distribution": "node --test .pbai4devs/tests/distribution.test.mjs",
    "pack:release": "node .pbai4devs/release/assets.mjs",
    "test:infra": "node .pbai4devs/scripts/testar-infraestrutura/SCRIPT.mjs",
    "generate": "node .pbai4devs/scripts/sincronizar-agentes/SCRIPT.mjs",
    "check": "node .pbai4devs/release/pipeline.mjs check",
    "ci:full": "node .pbai4devs/release/pipeline.mjs full",
    "ci:portable": "node .pbai4devs/release/pipeline.mjs portable",
    "ci:smoke": "node .pbai4devs/release/pipeline.mjs smoke"
  }
}
