{
  "name": "opensrc",
  "description": "Consulta e download de fontes de dependencias.",
  "group": "source",
  "source": "https://github.com/vercel-labs/opensrc/tree/main/packages/opensrc",
  "download": {
    "provider": "npm",
    "package": "opensrc",
    "registry": "https://registry.npmjs.org/",
    "repository": "vercel-labs/opensrc",
    "channel": "latest"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-x64"
  ],
  "scripts": {
    "entry": "SCRIPT.mjs"
  },
  "envPaths": {
    "OPENSRC_HOME": "cache"
  },
  "probe": [
    "--version"
  ]
}
