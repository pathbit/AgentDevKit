{
  "name": "agent-browser",
  "description": "Automacao e verificacao em navegador real.",
  "group": "base",
  "source": "https://agent-browser.dev/installation",
  "download": {
    "provider": "npm",
    "package": "agent-browser",
    "registry": "https://registry.npmjs.org/",
    "repository": "vercel-labs/agent-browser",
    "channel": "latest"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "executables": {
    "darwin-arm64": ["bin/agent-browser-darwin-arm64"],
    "darwin-x64": ["bin/agent-browser-darwin-x64"],
    "linux-arm64": ["bin/agent-browser-linux-arm64", "bin/agent-browser-linux-musl-arm64"],
    "linux-x64": ["bin/agent-browser-linux-x64", "bin/agent-browser-linux-musl-x64"]
  },
  "optionalExecutables": {
    "darwin-arm64": [{"package": "@agent-browser/cli-darwin-arm64", "file": "bin/agent-browser"}],
    "darwin-x64": [{"package": "@agent-browser/cli-darwin-x64", "file": "bin/agent-browser"}],
    "linux-arm64": [{"package": "@agent-browser/cli-linux-arm64-gnu", "file": "bin/agent-browser"}, {"package": "@agent-browser/cli-linux-arm64-musl", "file": "bin/agent-browser"}],
    "linux-x64": [{"package": "@agent-browser/cli-linux-x64-gnu", "file": "bin/agent-browser"}, {"package": "@agent-browser/cli-linux-x64-musl", "file": "bin/agent-browser"}],
    "win32-arm64": [{"package": "@agent-browser/cli-win32-x64-msvc", "file": "bin/agent-browser.exe"}],
    "win32-x64": [{"package": "@agent-browser/cli-win32-x64-msvc", "file": "bin/agent-browser.exe"}]
  },
  "scripts": {
    "entry": "SCRIPT.mjs"
  },
  "probe": [
    "--version"
  ]
}
