{
  "name": "agent-desktop",
  "description": "Automacao e verificacao de aplicativos desktop.",
  "group": "desktop",
  "source": "https://agent-browser.dev/desktop/installation",
  "download": {
    "provider": "npm",
    "package": "agent-desktop",
    "registry": "https://registry.npmjs.org/",
    "repository": "vercel-labs/agent-desktop",
    "channel": "latest"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "scripts": {
    "entry": "SCRIPT.mjs"
  },
  "envPaths": {
    "AGENT_DESKTOP_HOME": "state"
  },
  "probe": [
    "version"
  ]
}
